# ==============================================================================
# FloodWatch Docker Ignore
# ==============================================================================
# Prevent leaking local secrets, git history, cache, virtualenvs, or dev artifacts

# Git & GitHub
.git/
.github/
.gitignore

# Environment & Credentials (CRITICAL: Never bake secrets into container images)
*.env
*.env.*
!.env.example
*.pem
*.key
*.cert

# Python Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Node & Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
.npm/

# Logs & Temporary Files
*.log
tmp/
temp/

# IDE & OS Files
.vscode/
.idea/
.DS_Store
Thumbs.db
