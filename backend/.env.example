# ==============================================================================
# FloodWatch Backend Configuration Template (.env.example)
# ==============================================================================
# Copy this file to backend/.env and populate with appropriate values.
# NEVER commit .env or real credentials to source control.
#
# Environment Modes:
# - development: DEBUG=true, default tokens allowed, Swagger docs enabled.
# - production:  DEBUG=false required, strong tokens required, wildcard CORS forbidden.
# ==============================================================================

# --- Application Runtime Settings ---
ENVIRONMENT=development
APP_NAME=FloodWatch-API
APP_VERSION=0.1.0
DEBUG=true
PORT=8000
HOST=127.0.0.1

# Documentation (Auto-enabled in development; disabled in production unless explicitly set)
# ENABLE_DOCS=false

# --- Cross-Origin Resource Sharing (CORS) ---
# JSON array or comma-separated list of allowed origins.
# In production, specify exact origin domains. Wildcard '*' is strictly prohibited with credentials.
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# --- External Meteorological API (Open-Meteo) ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_TIMEOUT_SECONDS=10.0
OPEN_METEO_MAX_RETRIES=3
OPEN_METEO_BACKOFF_FACTOR=0.5
OPEN_METEO_MAX_WAIT_SECONDS=60.0

# --- Database & Persistence (Supabase PostgreSQL / PostGIS) ---
# NOTE: Service-role key is strictly for backend operations and must NEVER be exposed to clients.
# In development, database operations fall back gracefully if remote Supabase is unreachable.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/floodwatch
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# --- Ingestion Security & Authentication ---
# Secret bearer token used to authorize administrative / manual ingestion triggers.
# In production, replace with a cryptographically secure random string (min 32 chars).
INGESTION_TRIGGER_TOKEN=floodwatch-dev-secret-token

# --- Telemetry Freshness Thresholds (Minutes) ---
FRESHNESS_FRESH_MINUTES=60
FRESHNESS_DELAYED_MINUTES=180
FRESHNESS_STALE_MINUTES=360

# --- Automated Ingestion Scheduler (Phase 2.6) ---
# SINGLE-PROCESS CONSTRAINT:
# The scheduler runs in-process via asyncio. In multi-worker deployments (e.g. Gunicorn -w 4),
# keep this set to false to prevent race conditions and duplicate Open-Meteo API ingestion cycles.
# Enable ONLY when running a single Uvicorn process or a dedicated scheduler worker/sidecar.
ENABLE_INGESTION_SCHEDULER=false
INGESTION_SCHEDULE_INTERVAL_MINUTES=60
