# ==============================================================================
# FloodWatch Frontend Configuration Template (.env.example)
# ==============================================================================
# Copy this file to frontend/.env and configure environment variables.
#
# CRITICAL SECURITY NOTICE:
# Any variable prefixed with VITE_ is embedded into the client-side JavaScript bundle
# during compilation and is fully visible to anyone accessing the site.
#
# - NEVER put SUPABASE_SERVICE_ROLE_KEY or database connection strings here.
# - Keep this file limited to safe public URLs and non-sensitive identifiers.
# ==============================================================================

# API Base URL (Leave empty to use relative /api proxy in development & Nginx in production)
# Set only if the frontend is hosted on a separate origin domain from the API.
VITE_API_BASE_URL=

# Public Supabase Access (Used exclusively for client-side read-only queries with RLS)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Application Display Info
VITE_APP_TITLE=FloodWatch
